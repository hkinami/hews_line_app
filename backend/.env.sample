# LINE Login Configuration
# Channel ID from LINE Developers Console
LINE_CHANNEL_ID=your_line_channel_id

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com

